{
  "name": "xcode-mcp",
  "version": "1.0.0",
  "description": "MCP server for Xcode integration - build, test, debug, and control Xcode projects from AI",
  "type": "module",
  "bin": {
    "xcode-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --dts --out-dir dist --target node18",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/qa.test.ts",
    "setup": "node scripts/setup-clients.mjs --client all",
    "setup:all": "node scripts/setup-clients.mjs --client all",
    "setup:opencode": "node scripts/setup-clients.mjs --client opencode",
    "setup:cline": "node scripts/setup-clients.mjs --client cline",
    "setup:kilo": "node scripts/setup-clients.mjs --client kilo",
    "setup:freebuff": "node scripts/setup-clients.mjs --client freebuff",
    "install:py": "python3 install.py",
    "ctl": "python3 serverctl.py",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "keywords": [
    "xcode",
    "mcp",
    "modelcontextprotocol",
    "ios",
    "swift",
    "opencode",
    "cline",
    "kilo-code",
    "freebuff",
    "codebuff"
  ]
}
